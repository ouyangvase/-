{
  "buildCommand": "pnpm run vercel:build",
  "outputDirectory": "apps/miniapp/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/telegram/webhook.js": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/internal/round-advancer", "schedule": "* * * * *" }
  ],
  "headers": [
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=:path*" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
