APP_MODE=production
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=PROJECT_12
NEXT_PUBLIC_APP_URL=http://localhost:4173
NEXT_PUBLIC_ADMIN_URL=http://localhost:4174
API_PORT=8787
MINIAPP_ORIGIN=http://localhost:4173
ADMIN_ORIGIN=http://localhost:4174
CORS_ORIGIN=http://localhost:4173
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
DIRECT_URL=postgresql://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-local-only
KYC_ENCRYPTION_KEY=replace-local-only
DEVICE_TOKEN_SECRET=replace-local-only
ADMIN_SESSION_SECRET=replace-local-only
INTERNAL_WORKER_SECRET=replace-local-only
SENTRY_DSN=
LOG_LEVEL=info

# Telegram boundary. Leave blank locally; provide only in an authorized staging environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=<bot_username>
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-miniapp-domain.example/api/telegram/webhook
TELEGRAM_MINI_APP_URL=http://localhost:4173
# The game is played in the Mini App internal room. No Telegram native group is required.
TELEGRAM_MOCK_ENABLED=false
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
BOT_USERNAME=<bot_username>
MAX_ACTIVE_PRIMARY_DEVICES=1

# Production safety switches: keep disabled until legal, provider and ledger review are complete.
REAL_MONEY_ENABLED=false
TOP_UP_ENABLED=false
WITHDRAWAL_ENABLED=false
CASH_REWARD_ENABLED=false
PACKET_PROVIDER=internal
TNG_INTEGRATION=disabled
PAYMENT_PROVIDER=disabled

# Vite client variables.
VITE_API_URL=http://localhost:8787
VITE_BUILD_COMMIT=local
WORKER_INTERVAL_MS=1000
REQUIRE_WORKER=true
